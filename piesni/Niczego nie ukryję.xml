<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.2" modifiedIn="OpenLP 3.1.2" modifiedDate="2026-05-20T12:10:55">
  <properties>
    <titles>
      <title>Niczego nie ukryję</title>
    </titles>
    <authors>
      <author>a</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Wszechmocny, Wszechpotężny, <br/>Święty Bóg.<br/>Przychodzi dziś, spogląda w serce me.<br/>Niczego nie ukryję - ufam Mu.<br/>To mój Bóg - kocha mnie.</lines>
    </verse>
  </lyrics>
</song>
